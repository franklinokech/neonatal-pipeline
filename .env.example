# REDCap API
REDCAP_STANDARD_API_URL=https://your.standard.redcap/api/
REDCAP_STANDARD_API_TOKEN=TOKEN_STANDARD
REDCAP_PUMWANI_API_URL=https://your.pumwani.redcap/api/
REDCAP_PUMWANI_API_TOKEN=TOKEN_PUMWANI
REDCAP_NEST_API_URL=https://your.nest.redcap/api/
REDCAP_NEST_API_TOKEN=TOKEN_NEST

# Sync window (days)
INCREMENTAL_WINDOW_DAYS=30

# Email (Gmail)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_TO=recipient@example.com

# Logging and cache
LOG_FILE=/app/logs/pipeline.log
USE_CACHE=false
REFRESH_CACHE=false
CACHE_DIR=/app/cache